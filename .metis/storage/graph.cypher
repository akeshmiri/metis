430366516, 0.00853237509727478, -0.051086872816085815, 0.055054932832717896, -0.01807132363319397, 0.04758823290467262, -0.0449431948363781, -0.12554237246513367, 0.056388258934020996, 0.06618722528219223, 0.02089097909629345, 0.0018249914282932878, 0.02268981747329235, 0.01295140478760004, -0.049308132380247116, -0.09458661079406738, 0.09830813109874725, -0.09864792972803116, 0.041034914553165436, -0.06412335485219955, 0.037641942501068115, -0.052895497530698776, 0.034387581050395966, -0.01252913847565651, 0.007217733655124903, 0.03640581667423248, -0.01344273891299963, -0.024829845875501633, -0.003272601403295994, -0.029158322140574455, 0.004781664349138737, 0.029522031545639038, -0.05774860084056854, 0.0004194156499579549, 0.04667363315820694, 0.01961132511496544, -0.0017921021208167076, 0.003746258793398738, 0.057705290615558624, -0.03363668546080589, -0.05902852118015289, -0.049036964774131775, 0.023597341030836105, 0.001011818414554, -0.02347339317202568, -0.04179834946990013, 0.05691495165228844, 0.016291236504912376, 0.036339517682790756, -0.09162279963493347, 0.012244398705661297, 0.08763991296291351, 0.01639406569302082, -0.012388220056891441, -0.079290010035038, -0.002131075831130147, 0.004421319346874952, 0.00019611313473433256, 0.011574762873351574, 0.006868333555757999, 0.01919729635119438, -0.06188243255019188, -0.058072779327631, 0.01581859216094017, -0.026463234797120094, -0.05098296329379082, -0.022856108844280243, -0.024594072252511978, 0.013980384916067123, -0.019794531166553497, 0.04272155463695526, -0.008692354895174503, -0.019511546939611435, -0.003064677119255066, -0.014596564695239067, -0.05249587446451187, -0.00016845022037159652, 0.0027645162772387266, 0.01998789608478546, -0.005369632970541716, 0.07764911651611328, -0.010331399738788605, -0.004072144627571106], id: "lesson:05-the-two-gates#01", text: "# 5 \u00b7 The two gates, and why there are only two\n\nM\u00e9tis stops for a human twice. Everything else runs unattended, and the two\nplaces it stops are chosen so that the **safe failure is always \"no tests\ngenerated\"**, never \"tests generated from something nobody checked\".\n\n| Gate | Sits before | Decides | Evidence a reviewer is shown |\n|---|---|---|---|\n| **G1 \u2014 model approval** | anything is generated | is this behaviour real | validation findings, reconciliation gaps, the criteria each rule carries |\n| **G2 \u2014 publication** | any external write | do we send this | the whole batch, in full |", search_text: "5 \u00b7 The two gates, and why there are only two # 5 \u00b7 The two gates, and why there are only two\n\nMetis stops for a human twice. Everything else runs unattended, and the two\nplaces it stops are chosen so that the **safe failure is always \"no tests\ngenerated\"**, never \"tests generated from something nobody checked\".\n\n| Gate | Sits before | Decides | Evidence a reviewer is shown |\n|---|---|---|---|\n| **G1 \u2014 model approval** | anything is generated | is this behaviour real | validation findings, reconciliation gaps, the criteria each rule carries |\n| **G2 \u2014 publication** | any external write | do we send this | the whole batch, in full |", ordinal: 1}, {m_project: "metis", source_episode_id: "ep-lessons-f300da3676163a62", embedding_model: "minishlab/potion-base-8M", name: "Nothing auto-approves, and nothing expires into approval", embedding: [-0.32799413800239563, 0.21479350328445435, -0.21854451298713684, -0.08278398960828781, 0.22462329268455505, 0.09092273563146591, -0.06277280300855637, 0.02724522538483143, 0.05449941009283066, -0.05719578266143799, -0.0911610797047615, 0.012569127604365349, -0.06530549377202988, -0.04315692186355591, 0.06471490859985352, -0.12097501754760742, -0.04965608939528465, -0.02820085734128952, -0.013163229450583458, -0.18358846008777618, 0.06931988149881363, 0.01984519511461258, -0.05485985055565834, -0.11818744242191315, -0.11488457024097443, -0.04496895521879196, -0.04515563324093819, -0.09957865625619888, 0.1201