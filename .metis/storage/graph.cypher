15, -0.014218823984265327, -0.01434041652828455, -0.005795217119157314, 0.0195848997682333, -0.0308711975812912, -0.0570547841489315, 0.029007602483034134, 0.02312306873500347, 0.027170663699507713, -0.008693400770425797, 0.017738524824380875, -0.010840988717973232, 0.08085118979215622, -0.026309778913855553, -0.03478696197271347, -0.008351020514965057, -0.05817236378788948, 0.032733380794525146, -0.010501012206077576, 0.07034844905138016, -0.07401473820209503, 0.051904112100601196, -0.0010899220360442996, 0.08568606525659561, 0.004545577336102724, -0.05474506691098213, 0.057875022292137146, -0.04659609869122505, 0.009751914069056511, -0.0037606044206768274, -0.01627305895090103, -0.0010592754697427154, 0.05024350807070732, 0.03042428568005562, -0.0524204857647419, -0.018528884276747704, -0.00011405268014641479, 0.014201199635863304, 0.018077928572893143, 0.031081389635801315, 0.0015037611592561007, -0.05244931951165199, -0.0377194881439209, -0.011898601427674294, -0.005575132556259632, 0.03150121122598648, 0.017394183203577995, -0.023968249559402466, -0.01178495679050684], search_text: "It does not approve its own work ## It does not approve its own work\n\nEverything recovered lands at `Quarantine` (**S-4**). No source writes\n`Approved`. Generation reads only `Approved` (**D-10**). The gap between those\ntwo sentences is a person, and it is not optional \u2014 the two human gates exist\nbecause an agent session cannot provide the evidence presentation that N-3\nrequires for a decision.", ordinal: 4}, {m_project: "metis", source_episode_id: "ep-lessons-f300da3676163a62", embedding_model: "minishlab/potion-base-8M", name: "It does not publish", id: "lesson:01-what-metis-does-not-do#05", text: "## It does not publish\n\n`DryRunTransport` is the only registered transport. `test-generate`'s `publish`\nstage builds and validates a real payload and sends nothing. If you pass a G2\nconfirmation expecting a write to a test management tool, you will get a\nsuccessful dry run and no write.", embedding: [-0.13748742640018463, 0.23877203464508057, -0.1469583958387375, -0.29330310225486755, 0.17978793382644653, 0.17221827805042267, 0.10493363440036774, 0.016417689621448517, -0.06348967552185059, 0.02818269468843937, -0.047706473618745804, -0.01776876673102379, -0.1600572168827057, -0.009473881684243679, -0.023722562938928604, -0.01170275267213583, 0.09364684671163559, -0.015549232251942158, 0.10807422548532486, -0.041713111102581024, 0.050732024013996124, 0.006773301400244236, 0.006813856307417154, -0.04820246621966362, -0.1566944569349289, 0.07200412452220917, -0.1299617737531662, 0.009930180385708809, 0.0023296945728361607, 0.04782978445291519, -0.02705131098628044, -0.02612568438053131, 0.1736346334218979, 0.008028881624341011, 0.06706544756889343, 0.11021056026220322, 0.16475851833820343, 0.10173922032117844, 0.025253625586628914, 0.06875123083591461, -0.048016443848609924, -0.003590761451050639, 0.05737743526697159, -0.017485622316598892, 0.06128940358757973, -0.049214813858270645, 0.11027238517999649, -0.021215057000517845, -0.03334790840744972, 0.047371912747621536, -0.01626698300242424, -0.17961902916431427, -0.027097955346107483, 0.024066172540187836, 0.004399740602821112, 0.11644987016916275, -0.0590205043554306, -0.037059079855680466, 0.032011423259973526, 0.010793635621666908, 0.04117484390735626, -0.08004238456487656, 0.029464608058333397, -0.0965120792388916, 0.030796930193901062, 0.01585080474615097, 0.005822325590997934, -0.0693826675415039, 0.04876389726996422, 0.008878597058355808, 0.039364639669656754, -0.004276925232261419, 0.04403293505311012, 0.1455366611480713, -0.10962048172950745, 0.012088867835700512, -0.01976269856095314, 0.07870236784219742, -0.010389655828475952, -0.06697958707809448, 0.07304394990205765, -0.0019665032159537077, 0.054496631026268005, 0.018738076090812683, -0.008508069440722466, 0.012888919562101364, 0.05654359608888626, -0.06798828393220901, 0.13404211401939392, -0.08285149186849594, -0.03173