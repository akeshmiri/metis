 for", ordinal: 5}, {m_project: "metis", source_episode_id: "ep-lessons-f300da3676163a62", embedding_model: "minishlab/potion-base-8M", name: "5 \u00b7 The two gates, and why there are only two", embedding: [-0.2043856680393219, 0.20747968554496765, -0.239854633808136, -0.002383972518146038, 0.270365834236145, 0.054225463420152664, -0.00023592663637828082, -0.10373497009277344, -0.007401878945529461, 0.04785267636179924, -0.08470313996076584, 0.019281158223748207, -0.12229695171117783, -0.04683707654476166, 0.0027631183620542288, 0.03398054465651512, 0.03226257860660553, -0.04248056560754776, 0.15244950354099274, -0.13519880175590515, 0.004187427926808596, 0.09219524264335632, -0.12861160933971405, -0.2376222014427185, -0.1283331662416458, 0.06900548934936523, 0.025640344247221947, -0.06396803259849548, -0.04222886636853218, 0.11354034394025803, -0.015447696670889854, 0.07323954254388809, -0.061130769550800323, -0.09404182434082031, 0.10007958114147186, 0.03599443659186363, 0.10204216092824936, -0.0477447584271431, -0.02176721952855587, 0.034171223640441895, 0.004461296834051609, 0.008660007268190384, 0.07406578958034515, -0.0953986644744873, 0.07106569409370422, -0.00428416021168232, 0.07343173772096634, -0.06303520500659943, -0.04295709356665611, 0.018504366278648376, 0.07946187257766724, -0.11478375643491745, 0.020577212795615196, 0.07920358330011368, 0.0034169405698776245, 0.037618838250637054, -0.038334984332323074, -0.06743485480546951, 0.042449623346328735, -0.08647090941667557, 0.003945550881326199, -0.030576322227716446, 0.08152889460325241, -0.04029018059372902, -0.008906803093850613, -0.024700229987502098, 0.008673037402331829, -0.046066656708717346, -0.03319743275642395, 0.05372289568185806, -0.005874641239643097, -0.00402100570499897, 0.031300198286771774, 0.14662785828113556, 0.02115667425096035, -0.048973821103572845, -0.03866419568657875, 0.058764707297086716, 0.04899837449193001, -0.02428540214896202, -0.06408505141735077, -0.04679267480969429, 0.03