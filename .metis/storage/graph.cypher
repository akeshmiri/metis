6, -0.013867060653865337, -0.05154655873775482, 0.03304038569331169, 0.005478275008499622, 0.010126846842467785, -0.05082868039608002, 0.048076383769512177, -0.10239214450120926, 0.06345263868570328, -0.015386196784675121, 0.009767946787178516, -0.06314374506473541, -0.02433517388999462, 0.018685009330511093, -0.1222434863448143, 0.06878630071878433, -0.04553132504224777, -0.05952708423137665, -0.03335089609026909, 0.08272909373044968, 0.026204628869891167, -0.0004011781420558691, 0.00369710149243474, 0.002206475706771016, 0.029450010508298874, -0.02725391834974289, -0.04130442813038826, -0.017560133710503578, -0.06735753268003464, 0.05694063380360603, -0.014351414516568184, 0.03922649100422859, -0.022734176367521286, 0.010941581800580025, 0.01852262206375599, 0.007314093876630068, -0.005640226416289806, -0.07201799005270004, 0.007799151819199324, 0.07117985188961029, 0.03185020014643669, 0.0037854239344596863, -0.04489834979176521, 0.07772443443536758, -0.06299091875553131], text: "## Why a whole service is re-extracted every time\n\nA code property graph is **whole-program** \u2014 call graphs and type resolution are\nglobal \u2014 so there is no meaningful per-file rebuild. What is incremental is\neverything after: identity is content-derived, so re-landing unchanged content\nwrites nothing new, and an unchanged tree never re-invokes the engine at all.\n\nFor review, `impact` takes the files in a diff and answers which recovered\nbehaviour they touch. That turns *re-extract everything* into *re-review only\nthis*.", search_text: "Why a whole service is re-extracted every time ## Why a whole service is re-extracted every time\n\nA code property graph is **whole-program** \u2014 call graphs and type resolution are\nglobal \u2014 so there is no meaningful per-file rebuild. What is incremental is\neverything after: identity is content-derived, so re-landing unchanged content\nwrites nothing new, and an unchanged tree never re-invokes the engine at all.\n\nFor review, `impact` takes the files in a diff and answers which recovered\nbehaviour they touch. That turns *re-extract everything* into *re-review only\nthis*.", ordinal: 5}, {m_project: "metis", source_episode_id: "ep-lessons-f300da3676163a62", embedding_model: "minishlab/potion-base-8M", name: "What you get at the end", text: "## What you get at the end\n\nHuman-executable test cases, and a coverage ledger keyed by transition. What you\ndo **not** get is a test that asserts a value nobody recovered: a payload renders\nas `<string, length 3..40, required>`, a base URL renders as `{base}` with its\nreason, and a UI element with no authored selector raises rather than guessing\n(**X-6e**).", id: "lesson:06-from-a-repository-to-test-cases#06", embedding: [-0.2227472960948944, 0.10519523918628693, -0.28977447748184204, -0.18434879183769226, 0.24675191938877106, 0.0914776623249054, 0.04868227243423462, -0.028242964297533035, -0.22285741567611694, 0.027478089556097984, -0.1953112930059433, 0.0390893891453743, -0.09520835429430008, 0.0008771701250225306, -0.015002567321062088, 0.016879750415682793, -0.06777265667915344, -0.013637736439704895, 0.02146078832447529, -0.0852569118142128, -0.0453372560441494, 0.11729978770017624, 0.006390936207026243, -0.0015440854476764798, -0.03383227065205574, 0.027493556961417198, 0.011709161102771759, -0.12637671828269958, -0.049962118268013, -0.006262151524424553, -0.07963877171278, 0.09136994928121567, 0.04764312505722046, -0.036426521837711334, 0.036527037620544434, 0.12530863285064697, 0.13109426200389862, 0.005548043176531792, -0.007641831878572702, 0.0004566943971440196, 0.018386350944638252, -0.031120892614126205, 0.07339975237846375, 0.028099916875362396, 0.07120037078857422, -0.2021976262331009, -0.007830957882106304, -0.033563125878572464, -0.0015556842554360628, -0.006257146131247282, 0.014163129031658173, -0.09611605107784271, 0.019408762454986572, 0.046673547476530075, 0.0026157787069678307, 0.09326177835464478, -0.04974496364593506, 