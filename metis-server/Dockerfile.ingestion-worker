FROM python:3.13-slim
WORKDIR /app
COPY pyproject.toml requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY metis_mcp/ ./metis_mcp/
COPY connectors/ ./connectors/
COPY cognify/ ./cognify/
COPY guardrails/ ./guardrails/
COPY corpus/ ./corpus/
COPY ingestion_worker.py ./
EXPOSE 8091
# Same real fix as Dockerfile.mcp-server -- runAsNonRoot: true needs an
# actual non-root user in the image.
RUN useradd --create-home --uid 10001 metis
USER 10001
CMD ["python3", "ingestion_worker.py"]
