# The chart supplies config via its mounted JSON ConfigMap and METIS_HOME.
# Deliberately do not bundle a host config in the image: the shared
# ~/.metis/config.json contract must remain the deployment's source of truth.
# For standalone testing, mount a directory containing config.json with
# `-e METIS_HOME=/config -v /path/to/metis-config:/config`.
FROM python:3.13-slim
WORKDIR /app
COPY pyproject.toml requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY metis_mcp/ ./metis_mcp/
COPY corpus/ ./corpus/
EXPOSE 8090
ENV METIS_HTTP_PORT=8090
# Real bug found deploying this: values.yaml's securityContext.runAsNonRoot:
# true requires the image to actually run as non-root -- Kubernetes refused
# to start the pod ("container has runAsNonRoot and image will run as
# root") because nothing here ever created/switched to one.
RUN useradd --create-home --uid 10001 metis
USER 10001
CMD ["python3", "-m", "metis_mcp.server"]
