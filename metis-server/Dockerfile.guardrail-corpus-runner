FROM python:3.13-slim
WORKDIR /app
COPY pyproject.toml requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY metis_mcp/ ./metis_mcp/
COPY guardrails/ ./guardrails/
# Consistent with Dockerfile.mcp-server/Dockerfile.ingestion-worker -- runs
# non-root even though the CronJob template doesn't currently set
# runAsNonRoot at the container level (good practice regardless).
RUN useradd --create-home --uid 10001 metis
USER 10001
CMD ["python3", "-m", "guardrails.corpus_runner"]
