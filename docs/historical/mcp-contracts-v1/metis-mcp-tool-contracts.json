    "metis_ingest_swagger_analysis": {
      "description": "Atlas bridge (Phase D): lands intake-processor's Swagger/OpenAPI UIF as ExternalAPISpec + Endpoint nodes. data_model/DTO entries are reported as data_model_skipped, never silently dropped -- no Schema/DTO label exists in the closed ontology yet. Requires graph.backend: neo4j; returns {adapted: true} against the dogfooding LocalGraphStore.",
      "input": {
        "type": "object",
        "required": [
          "payload"
        ],
