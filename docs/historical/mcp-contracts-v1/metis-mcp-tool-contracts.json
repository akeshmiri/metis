          "orphan_acceptance_criteria": {
            "type": "array"
          },
          "orphan_acceptance_criterion_count": {
            "type": "integer",
            "minimum": 0
          },
          "condition_unit_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "metis_generate_transition_test_plan": {
