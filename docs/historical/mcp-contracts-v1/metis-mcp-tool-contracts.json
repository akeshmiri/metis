                "type": "integer",
                "minimum": 0
              },
              "implemented_transitions": {
                "type": "integer",
                "minimum": 0
              },
              "planned_transitions": {
                "type": "integer",
                "minimum": 0
              },
              "transitions_missing_requirements": {
                "type": "integer",
                "minimum": 0
              },
              "transitions_missing_acceptance_criteria": {
                "type": "integer",
                "minimum": 0
              },
              "acceptance_criteria_missing_test_cases": {
                "type": "integer",
                "minimum": 0
              },
              "transitions_with_pyramid_gaps": {
