    "metis_mine_requirements": {
      "description": "Two-stage intake mining: derive Requirement + AcceptanceCriterion (and, where the source genuinely describes one, State/Transition) from an Episode's raw_content, linking the full chain through TestDesign. Stage 1 is deterministic and free (segment, discard cue-less blocks, dedup, short-circuit already-EARS text); Stage 2 pays a model only for the ambiguous remainder and every proposal is re-verified deterministically (EARS + vagueness + source-grounding) before it can land. Nothing auto-writes: everything lands at lifecycle_state 'Quarantine', confidence 0.7, below ConfidenceTiering's 0.9 floor. Additive to metis_ingest_requirements, which is unchanged; both converge on submit_candidate(). Requires graph.backend: neo4j.",
      "input": {
        "type": "object",
        "required": [
          "episode_id"
        ],
        "properties": {
          "episode_id": {
            "type": "string",
            "description": "Id of an Episode carrying raw_content, e.g. 'flatfiles:corpus/spec.md'"
          },
          "confirm_cost": {
            "type": "boolean",
            "default": false,
            "description": "COST-08 confirmation for batches materially larger than typical."
          },
          "dry_run": {
            "type": "boolean",
            "default": true,
            "description": "Run Stages 1-2 and return the plan and cost without writing."
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "episode_id",
          "segmentation",
          "mining",
          "planned_chains",
          "dry_run"
        ],
        "properties": {
          "episode_id": {
            "type": "string"
          },
          "episode_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": "string",
            "description": "Resolved from config models.extraction, never hardcoded."
          },
          "segmentation": {
            "type": "object",
            "description": "Stage 1 counts incl. char_reduction_pct -- the share of source text that never reached a model."
          },
          "mining": {
            "type": "object",
            "description": "Stage 2 counts, calls_made and total_cost_usd."
          },
          "planned_chains": {
            "type": "integer"
          },
          "blocked": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Proposals rejected by deterministic verification, each with its reason and evidence span."
          },
          "unplannable": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "landed": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Present only when dry_run is false."
          },
          "refused": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Chains the guardrail gate declined, with reasons."
          },
          "dry_run": {
            "type": "boolean"
          },
          "requires_confirmation": {
            "type": "boolean",
            "description": "True when COST-08 gating stopped the batch."
          }
        }
      }
    },
    "metis_list_skills": {
      "description": "Runtime discovery of the Métis skill catalogue. Returns each skill's name, description, routing triggers, use-when text, step files and owning workflow agent, plus the workflow-agent groupings and supported clients -- all read from the real SKILL.md files and the router's Quick Routing table, never a hand-maintained list. Needs no graph backend, so it works against both 'local' and 'neo4j' and is the cheapest live-connection check.",
      "input": {
        "type": "object",
        "required": [],
        "properties": {}
      },
      "output": {
        "type": "object",
        "required": [
          "skills",
          "workflow_agents",
          "counts",
          "clients"
        ],
        "properties": {
          "skills": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "name, description, triggers[], use_when, steps[], workflow_agent, path"
          },
          "workflow_agents": {
            "type": "object",
            "description": "agent name -> {title, description, skills[], tools[]}"
          },
          "counts": {
            "type": "object",
            "description": "skills and workflow_agents totals"
          },
          "clients": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Clients an agent file is generated for, e.g. claude and copilot."
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source_episode_id",
        "source_connector",
        "t_recorded"
      ],
      "properties": {
        "source_episode_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_connector": {
          "type": "string"
        },
        "source_span": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            }
          }
        },
        "t_recorded": {
          "type": "string",
          "format": "date-time"
        },
        "t_valid": {
          "type": "string",
          "format": "date-time"
        },
        "t_invalid": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "gradedFact": {
      "type": "object",
      "required": [
        "value",
        "confidence_tier",
        "provenance"
      ],
      "properties": {
        "value": {},
        "confidence_tier": {
          "type": "string",
          "enum": [
            "auto_write",
            "quarantine",
            "rejected"
          ]
        },
        "corroboration_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "scope": {
      "type": "object",
      "description": "Exactly one of these -- the subgraph to score.",
      "oneOf": [
        {
          "properties": {
            "release_id": {
              "type": "string"
            }
          },
          "required": [
            "release_id"
          ]
        },
        {
          "properties": {
            "service_id": {
              "type": "string"
            }
          },
          "required": [
            "service_id"
          ]
        },
        {
          "properties": {
            "requirement_id": {
              "type": "string"
            }
          },
          "required": [
            "requirement_id"
          ]
        },
        {
          "properties": {
            "project_wide": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "project_wide"
          ]
        }
      ]
    },
    "transition_scope": {
      "type": "object",
      "description": "A Transition, State-machine, or standard graph scope to plan in State-Transition order.",
      "oneOf": [
        {
          "properties": {
            "transition_id": {
              "type": "string"
            }
          },
          "required": [
            "transition_id"
          ]
        },
        {
          "properties": {
            "state_machine_id": {
              "type": "string"
            }
          },
          "required": [
            "state_machine_id"
          ]
        },
        {
          "$ref": "#/$defs/scope"
        }
      ]
    }
  }
}
