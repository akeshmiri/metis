            "type": "array"
          },
          "transitions": {
            "type": "array"
          }
        }
      }
    },
    "metis_ingest_requirements": {
      "description": "Atlas bridge (Phase D): lands the canonical {state_transition_map, intents, requirements, acceptance_criteria} bundle. Sole path Requirement/AcceptanceCriterion nodes are created from Atlas -- every entity still passes through the real guardrail stack (structural validation, confidence tiering, server-side EARS re-check) via submit_candidate. Requires graph.backend: neo4j; returns {adapted: true} against the dogfooding LocalGraphStore.",
      "input": {
        "type": "object",
        "required": [
          "payload"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "string"
              },
              "scope_id": {
                "type": "string"
              },
              "state_transition_map": {
                "type": "object"
              },
              "intents": {
                "type": "array"
              },
              "requirements": {
                "type": "array"
              },
              "acceptance_criteria": {
                "type": "array"
              },
              "condition_coverage": {
                "type": "object",
                "description": "Validated condition-coverage artifact. Required when Requirements or Acceptance Criteria carry condition_unit_ids."
              }
            },
            "required": [
              "state_transition_map",
              "intents",
              "requirements",
              "acceptance_criteria"
            ]
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "state_machines_written": {
            "type": "integer"
          },
          "states_written": {
            "type": "integer"
          },
          "transitions_written": {
            "type": "integer"
          },
          "evidence_links_recorded": {
            "type": "integer"
          },
          "intents_written": {
            "type": "integer"
          },
          "intents_rejected": {
            "type": "integer"
          },
          "requirements_written": {
            "type": "integer"
          },
          "requirements_quarantined": {
            "type": "integer"
          },
          "requirements_rejected": {
            "type": "integer"
          },
          "ac_written": {
            "type": "integer"
          },
          "ac_rejected": {
            "type": "integer"
          },
          "ac_skipped_no_requirement": {
            "type": "integer"
          },
          "condition_coverage_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition_units_covered": {
            "type": "integer",
            "minimum": 0
          },
          "ears_disagreement": {
            "type": "array"
          },
          "adapted": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "state_machines_written",
          "states_written",
          "transitions_written",
          "evidence_links_recorded",
          "intents_written",
          "requirements_written",
          "requirements_quarantined",
          "requirements_rejected",
          "ac_written",
          "ac_skipped_no_requirement"
        ]
      }
    },
    "metis_ingest_repository_analysis": {
      "description": "Atlas bridge (Phase D): lands git-repository-analyzer's Repository/Epic/Defect/TestCase/Endpoint bundle. Never creates Requirement nodes -- inferred stories are formalized by requirement-analyzer and pushed separately via metis_ingest_requirements. Requires graph.backend: neo4j; returns {adapted: true} against the dogfooding LocalGraphStore.",
